FROM python:3.8-slim
RUN apt-get update && apt-get -y upgrade
RUN apt-get install -y wamerican git
RUN apt-get install -y gcc libgmp-dev
RUN pip3 install --default-timeout=100 web3~=6.14 git+https://github.com/bobanetwork/jsonrpclib.git jsonrpcclient redis python-dotenv fastecdsa
COPY ./offchain /
COPY ./aa_utils /aa_utils

CMD [ "python", "-u", "./offchain.py" ]
